<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base: usamos un tema Material sin ActionBar; Compose dibuja toda la UI -->
    <style name="Theme.TocToc" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.TocToc.Ring" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
